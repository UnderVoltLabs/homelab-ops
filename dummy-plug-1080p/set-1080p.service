# User service (systemd --user). Needs auto-login. No sudo.
[Unit]
Description=Force the dummy plug to 1920x1080@60 before Sunshine
Before=sunshine.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
# %h = home directory. Change the resolution in the script, not here.
ExecStart=%h/.local/bin/set-1080p.sh
# Retry if the display is not ready.
Restart=on-failure
RestartSec=3

[Install]
# Not xdg-desktop-autostart.target: Cinnamon never triggers it.
WantedBy=sunshine.service
